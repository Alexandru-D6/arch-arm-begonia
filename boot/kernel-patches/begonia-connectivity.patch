+
+&soc {
+	/* gen4m fullmac WLAN device. The gen4m AXI HIF is a platform_driver that
+	 * binds "mediatek,wifi": of_iomap reg[0] (WF CSR window), maps interrupt 0,
+	 * and of_reserved_mem_device_init() for its DMA pool. reg/irq/memory-region
+	 * match stock begonia-r-oss. Must be a &soc child (not under consys) so
+	 * of_platform_populate() creates its platform_device. The 1 MB reg overlaps
+	 * the consys sub-regions, which is safe: both map via non-exclusive
+	 * of_iomap, matching the stock layout. */
+	wifi: wifi@18000000 {
+		compatible = "mediatek,wifi";
+		reg = <0 0x18000000 0 0x100000>;
+		interrupts = <GIC_SPI 322 IRQ_TYPE_LEVEL_LOW>;	/* WF_HIF irq */
+		memory-region = <&wifi_mem>;
+		power-domains = <&spm MT6785_POWER_DOMAIN_CONN>;
+		status = "okay";
+	};
+
+	consys: consys@18002000 {
+		compatible = "mediatek,mt6785-consys";
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+		/*
+		 * Reg order is load-bearing: the vendor WMT driver
+		 * (consys_read_reg_from_dts in mt6785.c) iomaps these by numeric
+		 * index (CONSYS_BASE_ADDRESS_INDEX), matching stock begonia-r-oss
+		 * consys@18002000:
+		 *   0 MCU_BASE 1 TOP_RGU 2 INFRACFG_AO 3 SPM 4 CONN_HIF_ON
+		 *   5 TOP_MISC_OFF 6 MCU_CFG_ON 7 MCU_CIRQ 8 TOP_MISC_ON
+		 *   9 CONN_HIF_PDMA 10 AP_PCCIF4 11 INFRA_AO_PERICFG
+		 */
+		reg = <0 0x18002000 0 0x1000>,	/* 0  CONN_MCU_CONFIG_BASE */
+		      <0 0x10007000 0 0x0100>,	/* 1  TOP_RGU_BASE */
+		      <0 0x10001000 0 0x1000>,	/* 2  INFRACFG_AO_BASE */
+		      <0 0x10006000 0 0x1000>,	/* 3  SPM_BASE */
+		      <0 0x18007000 0 0x1000>,	/* 4  CONN_HIF_ON_BASE */
+		      <0 0x180b1000 0 0x1000>,	/* 5  CONN_TOP_MISC_OFF_BASE */
+		      <0 0x180a3000 0 0x1000>,	/* 6  CONN_MCU_CFG_ON_BASE */
+		      <0 0x180a5000 0 0x0800>,	/* 7  CONN_MCU_CIRQ_BASE */
+		      <0 0x180c1000 0 0x1000>,	/* 8  CONN_TOP_MISC_ON_BASE */
+		      <0 0x18004000 0 0x1000>,	/* 9  CONN_HIF_PDMA_BASE */
+		      <0 0x1024c000 0 0x0040>,	/* 10 AP2MD_PCCIF4_BASE */
+		      <0 0x10003000 0 0x1000>;	/* 11 INFRA_AO_PERICFG_BASE */
+		/* BGF_EINT, WDT_EINT, conn2ap_sw_irq (stock order; the vendor
+		 * reads irq idx 0 = BGF_EINT and idx 2 = conn2ap_sw_irq). */
+		interrupts = <GIC_SPI 321 IRQ_TYPE_LEVEL_LOW>,	/* BGF_EINT */
+			     <GIC_SPI 78 IRQ_TYPE_LEVEL_LOW>,	/* WDT_EINT */
+			     <GIC_SPI 323 IRQ_TYPE_EDGE_RISING>;	/* conn2ap_sw_irq */
+		/*
+		 * Vendor consys_clk_get_from_dts() requires clocks "conn" and
+		 * "ccif" or probe aborts. "ccif" = INFRACFG CCIF4 AP gate. Stock's
+		 * "conn" clock wrapped the conn power domain; mainline models that
+		 * as the power-domains phandle below, so there is no 1:1 "conn"
+		 * clock here.
+		 */
+		clocks = <&infracfg CLK_INFRA_CCIF4_AP>;
+		clock-names = "ccif";
+		power-domains = <&spm MT6785_POWER_DOMAIN_CONN>;
+		memory-region = <&consys_reserved>;
+		/* mt6359 PMIC regmap — conninfra driver forces XO_WCN (EXTBUF2,
+		 * the conn 26MHz clock buffer) on via DCXO_CW00. begonia is
+		 * non-co-clock so the vendor runtime relies on the preloader
+		 * leaving it HW-on; mainline has no mt6359 clk-buf driver. */
+		mediatek,pmic = <&pmic>;
+		/* Vendor mtk_wcn_get_regmap() reads the property "pmic" (not
+		 * "mediatek,pmic"); provide both so the vendor finds the mt6359
+		 * regmap. Non-fatal if absent. */
+		pmic = <&pmic>;
+		/* BTIF (WMT control channel to the conn MCU). The conninfra driver
+		 * sends the WMT FUNCTION_CTRL command that arms the WFSYS over this. */
+		mediatek,btif = <&btif>;
+		/* A-die analog rails (begonia WiFi has a SEPARATE A-die). Vendor
+		 * WMT consys_hw_on powers these mt6359 LDOs before WFSYS bring-up:
+		 * VCN18 1.8V + VCN33_1 3.3V (consys_hw_vcn18_ctrl) and VCN33_2 2.8V
+		 * (consys_hw_vcn28_ctrl, non-co-clock path). Without them the A-die
+		 * has no RF/PLL clock and the WFSYS rgu (0x180602cc[2]) never arms. */
+		vcn18-supply = <&mt6359_vcn18_ldo_reg>;
+		vcn33_1_wifi-supply = <&mt6359_vcn33_1_wifi_ldo_reg>;
+		vcn33_2_wifi-supply = <&mt6359_vcn33_2_wifi_ldo_reg>;
+		status = "okay";
+	};
+};
+
+#include <dt-bindings/clock/mediatek,mt6785-clk.h>
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+
+&soc {
+	btif: btif@1100c000 {
+		compatible = "mediatek,btif";
+		reg = <0 0x1100c000 0 0x1000>,	/* btif base */
+		      <0 0x11000b80 0 0x80>,	/* btif tx dma */
+		      <0 0x11000c00 0 0x80>;	/* btif rx dma */
+		interrupts = <GIC_SPI 138 IRQ_TYPE_LEVEL_LOW>,	/* btif */
+			     <GIC_SPI 155 IRQ_TYPE_LEVEL_LOW>,	/* tx dma */
+			     <GIC_SPI 154 IRQ_TYPE_LEVEL_LOW>;	/* rx dma */
+		clocks = <&infracfg CLK_INFRA_BTIF>,
+			 <&infracfg CLK_INFRA_AP_DMA>;
+		clock-names = "btifc", "apdmac";
+		status = "okay";
+	};
+};
+
+&consys {
+	wmac: wmac@18000000 {
+		compatible = "mediatek,mt6785-wmac";
+		/* Full conn_infra window (16 MB), matching mt7986-wmac: the mt798x
+		 * reg_map remaps offsets > 1 MB into this aperture. */
+		reg = <0 0x18000000 0 0x1000000>;
+		interrupts = <GIC_SPI 322 IRQ_TYPE_LEVEL_LOW>;
+		/* No memory-region: the conn-MCU/WFSYS firmware EMI carveout +
+		 * WF->EMI remap are owned by the parent consys node / conninfra
+		 * driver (consys_reserved). The wmac side reads firmware over the
+		 * mt76 FWDL ring (DMA), not the carveout. */
+		power-domains = <&spm MT6785_POWER_DOMAIN_CONN>;
+		/*
+		 * Disabled: this reimpl mt76 node maps the 16 MB conn window
+		 * at 0x18000000, overlapping the vendor consys regions. With
+		 * the vendor stack driving conn bring-up, this node must not
+		 * also probe and claim the shared conn power-domain. Also
+		 * disabled via CONFIG_MT7615_MT6785_WMAC=n in pmaports.
+		 */
+		status = "disabled";
+	};
+};
