+#if KERNEL_VERSION(5, 8, 0) <= CFG80211_VERSION_CODE
+void mtk_cfg_update_mgmt_frame_registrations(struct wiphy *wiphy,
+		struct wireless_dev *wdev, struct mgmt_frame_regs *upd)
+{
+	struct GLUE_INFO *glue = wiphy_priv(wiphy);
+	static const u16 frame_types[] = {
+		IEEE80211_STYPE_PROBE_REQ, IEEE80211_STYPE_ACTION,
+#if CFG_SUPPORT_SOFTAP_WPA3
+		IEEE80211_STYPE_AUTH, IEEE80211_STYPE_ASSOC_REQ,
+#endif
+	};
+	unsigned int i;
+	bool is_p2p;
+
+	if (!wdev || !wdev->netdev || !glue || !glue->u4ReadyFlag)
+		return;
+
+	is_p2p = mtk_IsP2PNetDevice(glue, wdev->netdev) > 0;
+	/* cfg80211 supplies a complete per-interface subtype bitmap. Translate
+	 * it to the vendor's filter updates, including removals. AP authentication
+	 * and association frames must reach userspace when registered there.
+	 */
+	for (i = 0; i < ARRAY_SIZE(frame_types); i++) {
+		u16 type = frame_types[i];
+
+		if (!is_p2p && type != IEEE80211_STYPE_PROBE_REQ &&
+		    type != IEEE80211_STYPE_ACTION)
+			continue;
+		mtk_cfg_mgmt_frame_register(wiphy, wdev, type,
+			!!(upd->interface_stypes & BIT(type >> 4)));
+	}
+}
+#endif
