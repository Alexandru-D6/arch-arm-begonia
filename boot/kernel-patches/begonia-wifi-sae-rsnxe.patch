 }
+
+/* The AP SME owns RSNXE content. Dropping it while rebuilding beacons or
+ * probe responses makes SAE H2E negotiation and EAPOL message 3 disagree.
+ */
+uint32_t rsnCalculateRsnxIELen(struct ADAPTER *prAdapter,
+	uint8_t ucBssIndex, struct STA_RECORD *prStaRec)
+{
+	struct BSS_INFO *bss;
+	struct P2P_SPECIFIC_BSS_INFO *p2p;
+
+	if (!prAdapter->fgIsP2PRegistered ||
+	    ucBssIndex >= prAdapter->ucHwBssIdNum)
+		return 0;
+	bss = GET_BSS_INFO_BY_INDEX(prAdapter, ucBssIndex);
+	if (!bss || !IS_BSS_APGO(bss) || bss->u4PrivateData >= KAL_P2P_NUM)
+		return 0;
+	p2p = prAdapter->rWifiVar.prP2pSpecificBssInfo[bss->u4PrivateData];
+	return p2p ? p2p->u2RsnxIeLen : 0;
+}
+
+void rsnGenerateRsnxIE(struct ADAPTER *prAdapter,
+	struct MSDU_INFO *prMsduInfo)
+{
+	uint32_t len = rsnCalculateRsnxIELen(prAdapter,
+		prMsduInfo->ucBssIndex, NULL);
+	struct BSS_INFO *bss;
+	struct P2P_SPECIFIC_BSS_INFO *p2p;
+
+	if (!len)
+		return;
+	bss = GET_BSS_INFO_BY_INDEX(prAdapter, prMsduInfo->ucBssIndex);
+	p2p = prAdapter->rWifiVar.prP2pSpecificBssInfo[bss->u4PrivateData];
+	kalMemCopy((uint8_t *)prMsduInfo->prPacket + prMsduInfo->u2FrameLength,
+		p2p->aucRsnxIeBuffer, len);
+	prMsduInfo->u2FrameLength += len;
+}
