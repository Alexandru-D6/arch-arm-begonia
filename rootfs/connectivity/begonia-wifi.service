[Unit]
Description=Begonia internal MediaTek Wi-Fi
# Power the radio while sysinit (including random-seed initialization) runs.
# Waiting for basic.target serialized about 3.5 seconds of firmware startup
# behind a five-second entropy wait on the development handset.
DefaultDependencies=no
RequiresMountsFor=/usr/lib/modules /usr/lib/firmware /usr/local/sbin/begonia-wifi
After=systemd-modules-load.service systemd-remount-fs.service
Before=NetworkManager.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/begonia-wifi
RemainAfterExit=yes
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
